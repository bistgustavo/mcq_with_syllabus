# Copy to .env (Docker) and/or backend/.env (running locally), then fill in.
# Cloud services are tried first; local ones are the automatic fallback.

# ---- Environment ----
# "production" enables strict config checks, HSTS and hides /docs.
APP_ENV=development

# ---- MySQL ----
# Docker dev: host "mysql", port 3306.  Local dev: localhost:3307 (published port).
# Format: mysql+pymysql://mcq_user:<MYSQL_PASSWORD>@mysql:3306/mcq_platform
DATABASE_URL=
# Used by docker-compose (both files). Pick your own long random values.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ---- Qdrant (knowledge base) ----
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_LOCAL_URL=http://localhost:6333

# ---- Redis (task queue + AI rate-limit cooldowns) ----
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=
REDIS_LOCAL_URL=redis://localhost:6379/0

# ---- AI models: tried in this order; Ollama (local) takes over on rate limits ----
LLM_PROVIDER_ORDER=groq,gemini,ollama
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# ---- Web research (topics without PDFs) ----
SEARCH_BACKENDS=bing,yandex,duckduckgo

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated e-mails that are always administrators.
ADMIN_EMAILS=

# ---- Web ----
CORS_ORIGINS=http://localhost:5173
# docker-compose.prod.yml only: the public address of the site
PUBLIC_URL=https://exam.example.com
HTTP_PORT=80
MAX_UPLOAD_MB=25
